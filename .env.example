# Local Postgres from docker-compose.yml (`docker compose up -d`)
DATABASE_URL=postgres://agrinvest:agrinvest@127.0.0.1:5432/agrinvest
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public origin, used for canonical URLs, hreflang and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Indexing switch, flipped at launch (Phase 8). Until then every page is noindex.
SITE_INDEXABLE=false
# Cloudflare R2 for media (optional locally; without it uploads go to ./media)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# IndexNow key (any 8–128 hex chars); pings happen only when SITE_INDEXABLE=true
INDEXNOW_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/[task]; without it the route refuses every call
CRON_SECRET=
# Open-Meteo: the free API is non-commercial only. Production needs a paid key; with a key the base
# defaults to https://customer-api.open-meteo.com (decision 0008)
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=
