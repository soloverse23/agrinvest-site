{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/en",
        "http://localhost:3100/despre",
        "http://localhost:3100/cereale",
        "http://localhost:3100/cereale/grau",
        "http://localhost:3100/depozitare",
        "http://localhost:3100/baze/pogoanele",
        "http://localhost:3100/finantare",
        "http://localhost:3100/finantare/simulator",
        "http://localhost:3100/finantare/simulator?suma=300000&luni=24&culturi=wheat,maize&dobanda=10",
        "http://localhost:3100/finantare/aplica",
        "http://localhost:3100/contact",
        "http://localhost:3100/en/grain/wheat",
        "http://localhost:3100/en/bases/pogoanele",
        "http://localhost:3100/en/storage",
        "http://localhost:3100/magazin",
        "http://localhost:3100/magazin/erbicide",
        "http://localhost:3100/magazin/cultura/grau",
        "http://localhost:3100/magazin/insecticide/karate-zeon",
        "http://localhost:3100/en/shop/insecticides/karate-zeon"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "devtools",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1800
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 160000
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 32000
          }
        ],
        "resource-summary:stylesheet:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "document-title": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "link-text": "error",
        "crawlable-anchors": "error",
        "hreflang": "error",
        "canonical": "error",
        "image-alt": "error",
        "robots-txt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
