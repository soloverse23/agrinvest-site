{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/en",
        "http://localhost:3100/despre",
        "http://localhost:3100/baze/pogoanele",
        "http://localhost:3100/cereale/grau",
        "http://localhost:3100/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
