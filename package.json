{
  "name": "agrinvest-site",
  "version": "1.0.0",
  "description": "Agrinvest website: Next.js + Payload CMS (RO/EN)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3100",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:crawl": "tsx scripts/audit/crawl.ts",
    "audit:products": "tsx scripts/audit/products.ts",
    "audit:keywords": "tsx scripts/audit/keywords.ts",
    "audit:redirects": "tsx scripts/audit/redirects.ts",
    "audit:import": "tsx scripts/import/report.ts",
    "brand:logo": "tsx scripts/brand/build-logo.ts",
    "check:logo": "tsx scripts/checks/logo-diff.ts",
    "check:fonts": "tsx scripts/checks/fonts.ts",
    "review:shoot": "tsx scripts/checks/shoot.ts",
    "check:contrast": "tsx scripts/checks/contrast.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/index.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/demo/seed.ts",
    "seed:demo:guides": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/demo/guides.ts",
    "unseed:demo": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/demo/clear.ts",
    "check:seo": "tsx --env-file-if-exists=.env scripts/checks/seo.ts",
    "check:figures": "tsx --env-file-if-exists=.env scripts/checks/figures.ts",
    "brand:font": "tsx scripts/brand/subset-font.ts",
    "brand:map": "tsx scripts/brand/build-map.ts",
    "brand:clips": "tsx scripts/brand/clips.ts",
    "check:aeo": "tsx scripts/checks/aeo.ts",
    "check:finance": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/checks/finance.ts",
    "check:anaf": "tsx scripts/checks/anaf.ts",
    "check:budget": "tsx scripts/checks/budget.ts",
    "check:tools": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/checks/tools.ts",
    "check:products": "tsx --env-file-if-exists=.env scripts/checks/products.ts",
    "audit:verification": "tsx scripts/products/verification-list.ts",
    "apply:products": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/products/run.ts",
    "apply:finance": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/finance/run.ts",
    "apply:tools": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/tools/run.ts",
    "apply:articles": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/articles/run.ts",
    "apply:redesign": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/redesign/run.ts",
    "check:articles": "tsx --env-file-if-exists=.env scripts/checks/articles.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@payloadcms/translations": "^3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/blob": "2.8.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.92.1",
    "postcss": "^8.5.32",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@testing-library/react": "16.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/subset-font": "^2.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.9.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "ffmpeg-static": "^5.3.0",
    "fontkit": "^2.0.4",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "schema-dts": "^2.1.0",
    "storybook": "^10.6.5",
    "subset-font": "^2.9.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "private": true
}
